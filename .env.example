# ── Claude API ──────────────────────────────────────────────
# https://console.anthropic.com 에서 발급한 API 키
ANTHROPIC_API_KEY=sk-ant-...
# 사용할 모델 (기본: claude-opus-5-5)
PUMUI_MODEL=claude-opus-5-5
# 화면 조작 시 사고 수준: low / medium / high / xhigh / max
PUMUI_EFFORT=medium

# ── 업무포털 / K-에듀파인 ──────────────────────────────────
# 소속 시·도교육청 코드: sen(서울) pen(부산) dge(대구) ice(인천) gen(광주) dje(대전)
# use(울산) sje(세종) goe(경기) gwe(강원) cbe(충북) cne(충남) jbe(전북) jne(전남)
# gbe(경북) gne(경남) jje(제주)
PUMUI_REGION=sen
# 업무포털 주소를 직접 지정하려면 (비우면 지역 코드로 자동 결정)
PUMUI_PORTAL_URL=

# 교육행정 전자서명(EPKI) 인증서 암호. 비워두면 로그인 때 직접 입력하도록 안내합니다.
# 이 값은 Claude에게 전달되지 않고, 프로그램이 키보드로만 입력합니다.
PUMUI_CERT_PASSWORD=
# 인증서 목록에 여러 개가 보일 때 고를 사용자 이름(선택)
PUMUI_CERT_OWNER=

# ── 진행 범위 ──────────────────────────────────────────────
# save   : 품의 저장까지만 (결재요청은 사람이 직접)
# submit : 결재요청(상신)까지 진행 — 상신 직전에 반드시 교사 승인을 받습니다
PUMUI_STOP_AT=submit

# ── 브라우저 ───────────────────────────────────────────────
# chrome / msedge / chromium
PUMUI_BROWSER_CHANNEL=chrome
# 이미 켜 둔 크롬에 붙으려면 (크롬을 --remote-debugging-port=9222 로 실행)
PUMUI_CDP_URL=
PUMUI_VIEWPORT=1440x900
# 크롬 실행 파일 경로를 직접 지정할 때 (보통은 비워 둠)
PUMUI_BROWSER_PATH=
